{
    "name": "laravel/laravel",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "anandsiddharth/laravel-paytm-wallet": "^2.0",
        "bacon/bacon-qr-code": "^2.0",
        "barryvdh/laravel-dompdf": "^2.0",
        "braintree/braintree_php": "^6.21",
        "cartalyst/stripe-laravel": "^16.0",
        "consoletvs/charts": "6.*",
        "cyrildewit/eloquent-viewable": "^7.0",
        "devmarketer/easynav": "^1.0",
        "doctrine/dbal": "^3.1",
        "drewm/mailchimp-api": "^2.5",
        "guzzlehttp/guzzle": "^7.9",
        "h2akim/senangpay-php": "dev-master",
        "instamojo/instamojo-php": "^1.0",
        "intervention/image": "^2.7",
        "itskodinger/midia": "^1.4",
        "iyzico/iyzipay-php": "^2.0",
        "jackiedo/dotenv-editor": "^1.1",
        "jackiedo/timezonelist": "^5.0",
        "joedixon/laravel-translation": "^1.1",
        "jorenvanhocht/laravel-share": "^4.2",
        "kingflamez/laravelrave": "dev-master",
        "laracasts/flash": "^3.2",
        "laravel-notification-channels/onesignal": "^2.3",
        "laravel/framework": "^11.0",
        "laravel/helpers": "^1.1",
        "laravel/legacy-factories": "^1.1",
        "laravel/passport": "*",
        "laravel/socialite": "^5.1.3",
        "laravel/tinker": "^2.8",
        "laravel/ui": "^4.0",
        "laravolt/avatar": "^5.1",
        "mews/purifier": "^3.2",
        "midtrans/midtrans-php": "^2.4",
        "mollie/laravel-mollie": "^3.0",
        "mtownsend/read-time": "^2.0",
        "nwidart/laravel-modules": "^8.3",
        "obydul/laraskrill": "^1.1",
        "omise/omise-php": "^2.12",
        "orangehill/iseed": "^3.0",
        "owen-it/laravel-auditing": "*",
        "paragonie/random_compat": "*",
        "paypal/rest-api-sdk-php": "^1.6",
        "paytm/paytmchecksum": "^1.1",
        "php-flasher/flasher-toastr": "^2.1",
        "pragmarx/google2fa-laravel": "*",
        "pusher/pusher-php-server": "^7.0",
        "rap2hpoutre/fast-excel": "^5.5",
        "razorpay/razorpay": "^2.9",
        "realrashid/sweet-alert": "^7.2",
        "revolution/socialite-amazon": "^1.1",
        "shipu/php-aamarpay-payment": "^2.0.0",
        "silviolleite/laravelpwa": "^2.0",
        "simplesoftwareio/simple-qrcode": "*",
        "spatie/laravel-analytics": "^5.2",
        "spatie/laravel-backup": "*",
        "spatie/laravel-cookie-consent": "^3.3",
        "spatie/laravel-googletagmanager": "^2.6",
        "spatie/laravel-newsletter": "^5.2",
        "spatie/laravel-permission": "^6.10",
        "spatie/laravel-sitemap": "^7.0",
        "spatie/laravel-translatable": "^6.0",
        "srmklive/paypal": "^3.0",
        "stichoza/google-translate-php": "^4.0",
        "stripe/stripe-php": "^16.4",
        "tohidplus/laravel-vue-translation": "^2.0",
        "torann/currency": "^1.1.0",
        "torann/geoip": "^3.0.2",
        "twilio/sdk": "^6.16",
        "unicodeveloper/laravel-paystack": "^1.2",
        "yajra/laravel-datatables-oracle": "^11.1",
        "yoeunes/toastr": "^3.1"
    },
    "require-dev": {
        "authorizenet/authorizenet": "2.0.2",
        "barryvdh/laravel-debugbar": "^3.5",
        "fakerphp/faker": "^1.22",
        "filp/whoops": "^2.9.2",
        "imanghafoori/laravel-microscope": "^1.0",
        "mockery/mockery": "^1.4.2",
        "phpunit/phpunit": "^9.3.3"
    },
    "autoload": {
        "files": [
            "app/Helpers/Tracker.php",
            "app/Helpers/ProductPrice.php",
            "app/Helpers/ProductRating.php",
            "app/Helpers/ShippingPrice.php",
            "app/Helpers/GuestCartShipping.php",
            "app/Helpers/CategoryUrl.php",
            "app/Helpers/SubcategoryUrl.php",
            "app/Helpers/ChidCategoryUrl.php",
            "app/Helpers/ProductUrl.php",
            "app/Helpers/Twilosms.php",
            "app/Helpers/helper.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "Modules/",
            "paytm\\paytmchecksum\\": "vendor/paytm/paytmchecksum/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "scripts": {
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
  
    "minimum-stability": "dev",
    "prefer-stable": true
}
